<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/card_bg"
        android:padding="8dp"
        android:elevation="2dp">

        <Button
            android:id="@+id/btn_margin_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/margin_query_back"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tv_margin_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/margin_query_title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_margin_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/margin_query_refresh"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/pb_margin_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <WebView
        android:id="@+id/wv_margin"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>